const chatEl=document.getElementById("chat");
const restartBtn=document.getElementById("restart");

function addMessage(sender,content){
  const msg=document.createElement("div");
  msg.className="message "+sender;
  if(Array.isArray(content)){
    content.forEach(i=>{
      const div=document.createElement("div");
      div.className="menu-item";
      if(i.link){
        div.innerHTML=`<a href="${i.link}" target="_blank">${i.name} ↗</a>`;
      } else if(i.name.match(/^\d\./)){
        div.textContent=i.name;
        div.style.cursor="default";
      } else {
        div.textContent=i.name;
        div.onclick=()=>{addMessage("user",i.name);setTimeout(()=>handle(i.name),400)};
      }
      msg.appendChild(div);
    });
  } else {
    msg.textContent=content;
  }
  chatEl.appendChild(msg);
  chatEl.scrollTop=chatEl.scrollHeight;
}

function handle(cmd){
  const res=menuData[cmd];
  if(res) addMessage("bot",res);
  else addMessage("bot","Ketik kembali atau pilih menu di atas 😊");
}

function initBot(){
  chatEl.innerHTML="";
  addMessage("bot","Assalamu'alaikum! 🌙\nSelamat datang di GFFI Chat Bot.\nSilakan pilih menu di bawah ini:");
  setTimeout(()=>addMessage("bot",menuData["!Menu"]),600);
}

restartBtn.onclick=initBot;
