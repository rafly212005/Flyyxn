<style>
:root{
  --bg:#04090f;
  --text:#fffbe6;
  --box:rgba(8,18,30,.88);
  --n1:#f5c842;
  --n2:#2affc7;
  --n3:#93d5ff;
  --n4:#ff6b6b;
}
.light{
  --bg:#f0ede5;
  --text:#1a1005;
  --box:rgba(255,248,230,.92);
}
*{box-sizing:border-box;margin:0;padding:0}
body{
  background:var(--bg);
  color:var(--text);
  font-family:'Tajawal',Arial,sans-serif;
  text-align:center;
  overflow-x:hidden;
  transition:.4s;
  min-height:100vh;
}
canvas#bg{position:fixed;inset:0;z-index:0;pointer-events:none}

/* TOP */
.topbar{
  position:relative;z-index:2;
  display:flex;justify-content:space-between;align-items:center;
  padding:10px 16px;font-size:13px;
  background:rgba(0,0,0,.3);
  backdrop-filter:blur(6px);
  border-bottom:1px solid rgba(245,200,66,.2);
}
.topbar-brand{
  font-family:'Cinzel',serif;
  color:var(--n1);
  font-size:13px;
  letter-spacing:2px;
}
.toggle{cursor:pointer;font-size:20px;transition:.3s}
.toggle:hover{transform:rotate(20deg)}

/* HEADER */
header{
  position:relative;z-index:1;
  padding:24px 12px 10px;
}
header::before{
  content:"☪✨";
  position:absolute;
  top:6px;left:50%;
  transform:translateX(-50%);
  font-size:20px;
  animation:twinkle 3s infinite;
}
@keyframes twinkle{
  0%,100%{opacity:.7;transform:translateX(-50%) scale(1)}
  50%{opacity:1;transform:translateX(-50%) scale(1.15)}
}
h1{
  font-family:'Cinzel',serif;
  font-size:38px;
  letter-spacing:6px;
  color:var(--n1);
  text-shadow:0 0 24px var(--n1),0 0 60px rgba(245,200,66,.4);
  animation:pulse 4s infinite;
}
@keyframes pulse{
  50%{text-shadow:0 0 36px var(--n2),0 0 80px rgba(42,255,199,.3)}
}
.subtitle{
  font-size:12px;letter-spacing:3px;
  color:var(--n2);
  margin-top:4px;
  opacity:.8;
}

/* RAMADAN BANNER */
.ramadan-banner{
  position:relative;z-index:1;
  background:linear-gradient(135deg,rgba(245,200,66,.15),rgba(42,255,199,.1));
  border-top:1px solid rgba(245,200,66,.3);
  border-bottom:1px solid rgba(245,200,66,.3);
  padding:8px;
  font-size:13px;
  color:var(--n1);
  letter-spacing:1px;
  overflow:hidden;
}
.ramadan-scroll{
  display:inline-block;
  animation:marquee 20s linear infinite;
  white-space:nowrap;
}
@keyframes marquee{
  from{transform:translateX(100vw)}
  to{transform:translateX(-100%)}
}

/* NAV */
nav{
  position:relative;z-index:2;
  display:flex;flex-wrap:wrap;gap:6px;
  justify-content:center;
  padding:10px 10px 8px;
  background:rgba(0,0,0,.2);
  backdrop-filter:blur(4px);
}
.btn{
  padding:8px 16px;
  border-radius:30px;
  background:linear-gradient(135deg,rgba(42,255,199,.15),rgba(147,213,255,.1));
  color:var(--text);
  font-weight:bold;
  cursor:pointer;
  transition:.3s;
  font-size:13px;
  border:1px solid rgba(42,255,199,.35);
  letter-spacing:.5px;
}
.btn:hover,.btn.active{
  background:linear-gradient(135deg,var(--n2),var(--n3));
  color:#000;
  box-shadow:0 0 18px rgba(42,255,199,.6);
  transform:scale(1.05);
  border-color:transparent;
}

/* PAGE */
.page{display:none;opacity:0;transform:translateY(16px);transition:.4s;position:relative;z-index:1;padding:0 12px 20px}
.page.show{display:block;opacity:1;transform:none}
h2{
  color:var(--n2);font-size:17px;
  letter-spacing:2px;
  margin:16px 0 10px;
  font-family:'Cinzel',serif;
}

/* NEON BOX */
.neon{
  width:100%;max-width:520px;
  margin:12px auto;padding:18px;
  border-radius:20px;
  background:var(--box);
  border:1.5px solid rgba(245,200,66,.5);
  backdrop-filter:blur(10px);
  animation:glowbox 6s infinite;
}
@keyframes glowbox{
  0%,100%{border-color:rgba(245,200,66,.5)}
  50%{border-color:rgba(42,255,199,.5)}
}
.neon b{
