.chat::-webkit-scrollbar-track{background:transparent}
.chat::-webkit-scrollbar-thumb{background:rgba(42,255,199,.3);border-radius:4px}
.message{
  padding:12px 14px;border-radius:18px;
  animation:fadeIn .3s ease;font-size:.9em;
  white-space:pre-line;
