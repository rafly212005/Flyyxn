/* ========================
   PARTICLE SYSTEM
   Bintang kelap-kelip + partikel emas Ramadhan
======================== */
const canvas=document.getElementById("bg");
const ctx=canvas.getContext("2d");
let W,H;

function resize(){W=canvas.width=window.innerWidth;H=canvas.height=window.innerHeight}
window.addEventListener("resize",resize);resize();

// Stars
const stars=[];
for(let i=0;i<160;i++){
  stars.push({
    x:Math.random()*W,
    y:Math.random()*H,
    r:Math.random()*1.8+0.4,
    alpha:Math.random(),
    speed:Math.random()*0.4+0.1,
    twinkleSpeed:Math.random()*0.02+0.005,
    twinkleDir:Math.random()>0.5?1:-1
  });
}

// Gold sparkles (Ramadan particles)
const sparkles=[];
for(let i=0;i<40;i++){
  sparkles.push({
    x:Math.random()*W,
    y:Math.random()*H,
    r:Math.random()*2.5+1,
    alpha:Math.random()*0.7+0.1,
    vy:-(Math.random()*0.5+0.1),
    vx:(Math.random()-0.5)*0.3,
    life:Math.random()*100,
    maxLife:100+Math.random()*100
  });
}

// Crescent moon particles
const moons=[];
for(let i=0;i<8;i++){
  moons.push({
    x:Math.random()*W,
    y:Math.random()*H,
    size:Math.random()*12+8,
    alpha:Math.random()*0.06+0.02,
    vy:-(Math.random()*0.15+0.05)
  });
}

function drawStar(ctx,x,y,r,alpha){
  ctx.save();
  ctx.globalAlpha=alpha;
  ctx.fillStyle="#fffbe6";
  ctx.shadowBlur=r*4;
  ctx.shadowColor="rgba(245,200,66,0.8)";
  ctx.beginPath();
  ctx.arc(x,y,r,0,Math.PI*2);
  ctx.fill();
  ctx.restore();
}

function drawCross(ctx,x,y,r,alpha){
  ctx.save();
  ctx.globalAlpha=alpha*0.6;
  ctx.strokeStyle="#fffbe6";
  ctx.lineWidth=0.5;
  ctx.beginPath();
  ctx.moveTo(x-r*3,y);ctx.lineTo(x+r*3,y);
  ctx.moveTo(x,y-r*3);ctx.lineTo(x,y+r*3);
  ctx.stroke();
  ctx.restore();
}

function draw(){
  ctx.clearRect(0,0,W,H);

  // Draw stars with twinkle
  stars.forEach(s=>{
    s.y+=s.speed*0.25;
    if(s.y>H){s.y=0;s.x=Math.random()*W}
    s.alpha+=s.twinkleDir*s.twinkleSpeed;
    if(s.alpha>1){s.alpha=1;s.twinkleDir=-1}
    if(s.alpha<0.05){s.alpha=0.05;s.twinkleDir=1}
    drawStar(ctx,s.x,s.y,s.r,s.alpha);
    if(s.r>1.2) drawCross(ctx,s.x,s.y,s.r,s.alpha*0.4);
  });

  // Draw gold sparkles
  sparkles.forEach(p=>{
    p.x+=p.vx;p.y+=p.vy;p.life++;
    const progress=p.life/p.maxLife;
    const a=p.alpha*(1-progress);
    if(p.life>=p.maxLife){
      p.x=Math.random()*W;p.y=H+10;
      p.life=0;p.alpha=Math.random()*0.7+0.1;
    }
    ctx.save();
    ctx.globalAlpha=Math.max(0,a);
    ctx.fillStyle=`hsl(${45+Math.random()*20},100%,70%)`;
    ctx.shadowBlur=8;ctx.shadowColor="#f5c842";
    ctx.beginPath();
    // diamond shape
    const rr=p.r*(1-progress*0.5);
    ctx.moveTo(p.x,p.y-rr);
    ctx.lineTo(p.x+rr,p.y);
    ctx.lineTo(p.x,p.y+rr);
    ctx.lineTo(p.x-rr,p.y);
    ctx.closePath();ctx.fill();
    ctx.restore();
  });

  // Floating crescent moon silhouettes
  moons.forEach(m=>{
    m.y+=m.vy;
    if(m.y<-30){m.y=H+30;m.x=Math.random()*W}
    ctx.save();
    ctx.globalAlpha=m.alpha;
    ctx.fillStyle="#f5c842";
    ctx.font=`${m.size}px serif`;
    ctx.fillText("☪",m.x,m.y);
    ctx.restore();
  });

  requestAnimationFrame(draw);
}
draw();

