  letter-spacing:1px;
  color:var(--n1);
  font-size:14px;
}

/* ADMIN ROW - Rafly & Farhan side by side */
.admin-row{
  display:flex;
  gap:16px;
  justify-content:center;
  margin:10px 0;
  flex-wrap:wrap;
}
.admin-card{
  flex:1;min-width:130px;max-width:200px;
  background:rgba(245,200,66,.07);
  border:1px solid rgba(245,200,66,.3);
  border-radius:16px;
  padding:14px 10px;
  display:flex;flex-direction:column;
  align-items:center;gap:8px;
}
.avatar{
  width:72px;height:72px;border-radius:50%;
  display:flex;align-items:center;justify-content:center;
  font-family:'Cinzel',serif;font-size:26px;font-weight:bold;color:#000;
  box-shadow:0 0 28px var(--n1);
}
.avatar.main{background:linear-gradient(135deg,var(--n1),#ffb347)}
.avatar.vice{background:linear-gradient(135deg,var(--n2),var(--n3))}
.admin-label{font-size:11px;color:var(--n1);letter-spacing:1px;font-weight:bold}
.admin-name{font-size:15px;font-weight:bold}

/* OTHER ADMINS */
.bubble{
  display:inline-block;
  margin:5px;padding:8px 14px;
  border-radius:999px;
  border:1px solid var(--n2);
  cursor:pointer;
  animation:float 3s infinite;
  font-size:13px;
  transition:.3s;
  background:rgba(42,255,199,.05);
}
.bubble:hover{background:rgba(42,255,199,.2);transform:scale(1.08)}
@keyframes float{50%{transform:translateY(-5px)}}

/* LINK BUTTONS */
.link-btn{
  display:inline-block;
  margin:6px 4px;
  padding:10px 18px;
  border-radius:30px;
  background:linear-gradient(135deg,var(--n2),var(--n3));
  color:#000;font-weight:bold;font-size:14px;
  cursor:pointer;transition:.3s;border:none;
}
.link-btn:hover{transform:scale(1.06);box-shadow:0 0 20px rgba(42,255,199,.5)}

/* GAME GRID */
.grid{
  display:grid;
  grid-template-columns:repeat(2,1fr);
  gap:12px;
  max-width:440px;
  margin:12px auto;
}
@media(max-width:480px){.grid{grid-template-columns:1fr}}
.card{
  height:110px;border-radius:18px;
  border:1px solid rgba(42,255,199,.4);
  background:var(--box);
  display:flex;align-items:center;justify-content:center;
